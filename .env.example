# Hugging Face model. The default is music-specific and emits 512 dimensions.
AS_MODEL_ID=laion/larger_clap_music
AS_MODEL_REVISION=a0b4534a14f58e20944452dff00a22a06ce629d1
AS_EMBEDDER_BACKEND=clap

# CPU/runtime tuning.
AS_TORCH_THREADS=4
AS_BATCH_SIZE=4
AS_SAMPLE_INTERVAL_SECONDS=25
AS_MAX_DURATION_SECONDS=14400
AS_MAX_UPLOAD_MIB=1024

# Local, metadata-only telemetry. Disabled by default.
AS_TELEMETRY_ENABLED=0
AS_DATA_DIR=./data

# Optional: preload an existing batch/benchmark JSON into the browser's Mapped sets library.
# AS_INITIAL_PROFILE_EXPORT=/absolute/path/to/profiles.json

# Deterministic pre-inference filtering.
AS_MIN_RMS_DBFS=-48
AS_MAX_CLIPPED_RATIO=0.02

# Experimental post-embedding density trim: 0, 0.05, or 0.10. Off by default because the
# six-set benchmark performed better without it.
AS_EMBEDDING_OUTLIER_MAX_FRACTION=0
